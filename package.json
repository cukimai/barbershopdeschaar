{
  "name": "barbershopdeachterhoek",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/optimize-images.mjs",
    "prebuild": "node scripts/fetch-instagram.mjs && node scripts/optimize-images.mjs",
    "build": "next build",
    "postbuild": "node scripts/defer-scripts.mjs",
    "start": "serve out -l 4173",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "instagram": "node scripts/fetch-instagram.mjs",
    "images": "node scripts/optimize-images.mjs",
    "lighthouse": "lighthouse http://localhost:4173/ --view --chrome-flags=--headless=new"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "lighthouse": "^13.6.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ]
}
